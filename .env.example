# LLM-Anbindung: demo (ohne Modell), ollama (lokal) oder openai
LLM_PROVIDER=demo

# Modell (Standard: qwen2.5:7b für Ollama, gpt-4o-mini für OpenAI)
# LLM_MODEL=qwen2.5:7b

# Nur nötig, wenn Ollama nicht unter der Standardadresse läuft
# LLM_BASE_URL=http://localhost:11434/v1

# Nur für LLM_PROVIDER=openai. Niemals ins Repository committen!
# OPENAI_API_KEY=sk-...
